# Public site URL used for canonical URLs and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public read configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase secret. Add this directly in Vercel; never expose it in client code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Protects server-side job import endpoints.
IMPORT_SECRET=change-this-to-a-long-random-secret
