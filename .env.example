# Public site URL used for canonical metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact address shown in site configuration if you choose to expose one.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Protects server-side import endpoints. Generate a long random value.
IMPORT_SECRET=change-this-to-a-long-random-secret

# Future online database connection. Leave blank while using local SQLite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
