# Public site URL used for canonical URLs and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public read configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase secret. Add this directly in Vercel; never expose it in client code.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Protects manual server-side job import endpoints.
IMPORT_SECRET=change-this-to-a-long-random-secret

# Used by Vercel Cron to authorize scheduled imports.
CRON_SECRET=change-this-to-a-different-long-random-secret

# Password for the protected /admin job-management panel.
ADMIN_PASSWORD=change-this-to-a-strong-admin-password

# Optional soft-launch integrations.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=replace-with-search-console-verification-token
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
